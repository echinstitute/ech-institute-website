# Copy and paste these variables into your `.env.local`
# Get a project ID from https://cloud.walletconnect.com for WalletConnect/Reown cloud features.
# If you see "[Reown Config] Failed to fetch remote project configuration" (ENOTFOUND api.web3modal.org),
# the app still works with local defaults; the warning usually means offline or DNS/firewall blocking that host.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional: YouTube channel ID for podcast "Recent Highlights" RSS (defaults to @echinstitute).
# WiEP series uses @wiepteam (hardcoded in src/lib/podcast-youtube.ts).
# ECH_YOUTUBE_CHANNEL_ID=UCD9iiIwTRtLDYcEWONs2Q3A